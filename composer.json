{
	"name": "shappire-it/content-workflow-manager",
	"description": "Editorial approval workflow for WordPress posts, pages and custom post types.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Shappire IT"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"wp-phpunit/wp-phpunit": "^6.7",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Sit_Cwm\\Admin\\": "admin/",
			"Sit_Cwm\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Sit_Cwm\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"platform": {
			"php": "7.4.33"
		},
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit",
		"test:integration": [
			"@putenv WP_PHPUNIT__TESTS_CONFIG=tests/php/wp-tests-config.php",
			"phpunit --testsuite integration"
		]
	}
}
